.empty h2 {
    color: #aaa;
}

/* =========================
   MOBILE
========================= */

@media(max-width:700px) {

    header {
        padding: 0 15px;
    }

    .hero {
        padding: 60px 18px 40px;
    }

    .hero h1 {
        letter-spacing: -3px;
    }

    .search-area,
    .stats,
    .era-nav,
    #content {
        padding-left: 18px;
        padding-right: 18px;
