</style>
</head>

<body>

<header>

    <div class="logo">
        YZY ARCHIVE
    </div>

    <div class="header-right">

        <label class="upload-button">
            IMPORT SHEET
            <input
                id="fileInput"
                type="file"
                accept=".csv,.tsv,.txt"
            >
        </label>

        <button onclick="resetData()">
            RESET
        </button>

    </div>

</header>


<section class="hero">

    <h1>
        YZY<br>
        ARCHIVE
    </h1>

    <p>
        A searchable archive of eras, albums, songs and recordings.
        Import a Google Sheets CSV and the archive will automatically
        organize the information.
    </p>

</section>


<div class="search-area">

    <input
        id="search"
        class="search"
        placeholder="Search songs, eras, albums, years..."
        oninput="render()"
    >

</div>


<div class="stats">

    <div class="stat">
        <div id="songCount" class="stat-number">0</div>
        <div class="stat-label">Songs</div>
    </div>

    <div class="stat">
        <div id="eraCount" class="stat-number">0</div>
        <div class="stat-label">Eras</div>
    </div>

    <div class="stat">
        <div id="albumCount" class="stat-number">0</div>
        <div class="stat-label">Albums</div>
    </div>

</div>


<div id="eraNav" class="era-nav"></div>


<main id="content">

    <div class="empty">

        <h2>
            IMPORT YOUR ARCHIVE
        </h2>

        <p>
            Download your Google Sheet as a CSV file and click
            "IMPORT SHEET".
        </p>

    </div>

</main>


<div id="modal" class="modal">

    <div class="modal-box">

        <button
            class="close"
            onclick="closeModal()"
        >
            ×
        </button>

        <div id="modalContent"></div>

    </div>

</div>


<script>

/* ============================================================
   DATA
============================================================ */

let songs = [];

let selectedEra = "ALL";


/* ============================================================
   CSV PARSER
============================================================ */

function parseCSV(text) {

    const rows = [];

    let row = [];
    let value = "";
    let insideQuotes = false;

    for (let i = 0; i < text.length; i++) {

        const char = text[i];
        const next = text[i + 1];

        if (char === '"' && insideQuotes && next === '"') {

            value += '"';
            i++;

        }

        else if (char === '"') {

            insideQuotes = !insideQuotes;

        }

        else if (char === "," && !insideQuotes) {

            row.push(value.trim());
            value = "";

        }

        else if (
            (char === "\n" || char === "\r")
            && !insideQuotes
        ) {

            if (char === "\r" && next === "\n") {
                i++;
            }

            row.push(value.trim());

            if (row.some(x => x !== "")) {
                rows.push(row);
            }

            row = [];
            value = "";

        }

        else {

            value += char;

        }
    }

    if (value.length || row.length) {

        row.push(value.trim());

        if (row.some(x => x !== "")) {
            rows.push(row);
        }

    }

    return rows;

}


/* ============================================================
   NORMALIZE COLUMN NAMES
============================================================ */

function normalize(text) {

    return String(text || "")
        .toLowerCase()
        .replace(/[^a-z0-9]/g, "");

}


/* ============================================================
   CONVERT CSV TO SONG OBJECTS
============================================================ */

function convertCSV(text) {

    const rows = parseCSV(text);

    if (!rows.length) {
        return [];
    }

    const headers = rows[0].map(normalize);

    const findColumn = names => {

        for (const name of names) {

            const index = headers.indexOf(normalize(name));

            if (index !== -1) {
                return index;
            }

        }

        return -1;

    };


    const columns = {

        era: findColumn([
            "era",
            "period",
            "phase"
        ]),

        album: findColumn([
            "album",
            "project",
            "release"
        ]),

        song: findColumn([
            "song",
            "title",
            "track",
            "name"
        ]),

        year: findColumn([
            "year",
            "date"
        ]),

        status: findColumn([
            "status",
            "type",
            "release status"
        ]),

        description: findColumn([
            "description",
            "notes",
            "details",
            "info"
        ]),

        audio: findColumn([
            "audio",
            "audio url",
            "audiourl",
            "file",
            "mp3",
            "link"
        ]),

        cover: findColumn([
            "cover",
            "art",
            "image",
            "image url"
        ])

    };


    return rows.slice(1).map((row, index) => {

        const get = key => {

            const column = columns[key];

            if (column === -1) {
                return "";
            }

            return row[column] || "";

        };


        return {

            id: index,

            era: get("era") || "Unknown Era",

            album: get("album") || "Unknown Project",

            title: get("song") || `Untitled ${index + 1}`,

            year: get("year"),

            status: get("status"),

            description: get("description"),

            audio: get("audio"),

            cover: get("cover")

        };

    }).filter(song => song.title);

}


/* ============================================================
   FILE UPLOAD
============================================================ */

document
    .getElementById("fileInput")
    .addEventListener("change", event => {

        const file = event.target.files[0];

        if (!file) return;

        const reader = new FileReader();

        reader.onload = event => {

            try {

                songs = convertCSV(event.target.result);

                selectedEra = "ALL";

                localStorage.setItem(
                    "yzyArchive",
                    JSON.stringify(songs)
                );

                render();

            }

            catch(error) {

                alert(
                    "Could not read the spreadsheet. " +
                    "Make sure it is exported as CSV."
                );

                console.error(error);

            }

        };

        reader.readAsText(file);

    });


/* ============================================================
   INITIAL LOAD
============================================================ */

const saved = localStorage.getItem("yzyArchive");

if (saved) {

    try {

        songs = JSON.parse(saved);

    }

    catch {

        songs = [];

    }

}

render();


/* ============================================================
   ERA LIST
============================================================ */

function getEras() {

    return [
        ...new Set(
            songs
                .map(song => song.era)
                .filter(Boolean)
        )
    ];

}


/* ============================================================
   RENDER ERA NAVIGATION
============================================================ */

function renderEraNav() {

    const container =
        document.getElementById("eraNav");

    container.innerHTML = "";

    const allButton =
        document.createElement("button");

    allButton.className =
        "era-button " +
        (selectedEra === "ALL" ? "active" : "");

    allButton.textContent = "ALL";

    allButton.onclick = () => {

        selectedEra = "ALL";
        render();

    };

    container.appendChild(allButton);


    getEras().forEach(era => {

        const button =
            document.createElement("button");

        button.className =
            "era-button " +
            (selectedEra === era ? "active" : "");

        button.textContent = era;

        button.onclick = () => {

            selectedEra = era;
            render();

        };

        container.appendChild(button);

    });

}


/* ============================================================
   SEARCH
============================================================ */

function getFilteredSongs() {

    const search =
        document
            .getElementById("search")
            .value
            .toLowerCase()
            .trim();


    return songs.filter(song => {

        const matchesEra =
            selectedEra === "ALL"
            || song.era === selectedEra;


        const searchable = [

            song.title,
            song.album,
            song.era,
            song.year,
            song.status,
            song.description

        ]
        .join(" ")
        .toLowerCase();


        return matchesEra &&
            searchable.includes(search);

    });

}


/* ============================================================
   MAIN RENDER
============================================================ */

function render() {

    const content =
        document.getElementById("content");

    renderEraNav();


    document.getElementById("songCount")
        .textContent = songs.length;


    document.getElementById("eraCount")
        .textContent = getEras().length;


    document.getElementById("albumCount")
        .textContent = new Set(
            songs.map(song => song.album)
        ).size;


    if (!songs.length) {

        content.innerHTML = `

            <div class="empty">

                <h2>
                    IMPORT YOUR ARCHIVE
                </h2>

                <p>
                    Download your Google Sheet as a CSV
                    and import it above.
                </p>

            </div>

        `;

        return;

    }


    const filtered =
        getFilteredSongs();


    if (!filtered.length) {

        content.innerHTML = `

            <div class="empty">

                <h2>
                    NOTHING FOUND
                </h2>

                <p>
                    Try another search.
                </p>

            </div>

        `;

        return;

    }


    const grouped = {};


    filtered.forEach(song => {

        if (!grouped[song.era]) {
            grouped[song.era] = [];
        }

        grouped[song.era].push(song);

    });


    content.innerHTML = "";


    Object.keys(grouped).forEach(era => {

        const section =
            document.createElement("section");

        section.className = "era";


        const header =
            document.createElement("div");

        header.className = "era-header";


        header.innerHTML = `

            <div class="era-title">
                ${escapeHTML(era)}
            </div>

            <div class="era-count">
                ${grouped[era].length} SONGS
            </div>

        `;


        section.appendChild(header);


        const grid =
            document.createElement("div");

        grid.className = "song-grid";


        grouped[era].forEach((song, index) => {

            const card =
                document.createElement("div");

            card.className = "song";


            card.innerHTML = `

                <div class="song-number">
                    ${String(index + 1).padStart(2, "0")}
                </div>

                <div class="song-title">
                    ${escapeHTML(song.title)}
                </div>

                <div class="song-meta">
                    ${escapeHTML(song.album)}
                    ${song.year ? " • " + escapeHTML(song.year) : ""}
                </div>

                ${
                    song.status
                    ?
                    `<div class="status">
                        ${escapeHTML(song.status)}
                    </div>`
                    :
                    ""
                }

            `;


            card.onclick = () =>
                openSong(song);


            grid.appendChild(card);

        });


        section.appendChild(grid);

        content.appendChild(section);

    });

}


/* ============================================================
   SONG MODAL
============================================================ */

function openSong(song) {

    const modal =
        document.getElementById("modal");

    const content =
        document.getElementById("modalContent");


    let audioHTML = "";

    if (song.audio) {

        audioHTML = `

            <audio
                controls
                preload="none"
                src="${escapeAttribute(song.audio)}"
            ></audio>

        `;

    }


    content.innerHTML = `

        <div class="modal-title">
            ${escapeHTML(song.title)}
        </div>

        <div class="modal-info">

            ERA:
            ${escapeHTML(song.era)}

            <br>

            PROJECT:
            ${escapeHTML(song.album)}

            ${
                song.year
                ?
                `<br>YEAR: ${escapeHTML(song.year)}`
                :
                ""
            }

            ${
                song.status
                ?
                `<br>STATUS: ${escapeHTML(song.status)}`
                :
                ""
            }

        </div>

        ${
            song.description
            ?
            `
            <div class="modal-description">
                ${escapeHTML(song.description)}
            </div>
            `
            :
            ""
        }

        ${audioHTML}

    `;


    modal.classList.add("open");

}


/* ============================================================
   CLOSE MODAL
============================================================ */

function closeModal() {

    document
        .getElementById("modal")
        .classList.remove("open");

}


document
    .getElementById("modal")
    .addEventListener("click", event => {

        if (event.target.id === "modal") {
            closeModal();
        }

    });


/* ============================================================
   RESET
============================================================ */

function resetData() {

    if (
        confirm(
            "Remove the imported archive from this browser?"
        )
    ) {

        localStorage.removeItem("yzyArchive");

        songs = [];

        selectedEra = "ALL";

        render();

    }

}


/* ============================================================
   SECURITY / HTML ESCAPING
============================================================ */

function escapeHTML(value) {

    return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


function escapeAttribute(value) {

    return String(value || "")
        .replace(/"/g, "&quot;")
        .replace(/</g, "%3C")
        .replace(/>/g, "%3E");

}

</script>

</body>
</html>
